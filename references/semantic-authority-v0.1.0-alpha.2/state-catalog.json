              "required_refs": [
                "orbit.concept/policy",
                "orbit.concept/worker-lease"
              ],
              "guard": "先形成检查点并闭合当前 Lease；不可逆副作用未确认时不得自动重跑。",
              "emits": [
                "orbit.concept/runtime-event",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "complete_task_success",
              "from": "running",
              "to": "succeeded",
              "trigger": "结果契约和最低评价要求满足",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/result-package",
                "orbit.concept/evaluation-report"
              ],
              "guard": "Runtime completed 不能单独触发 succeeded；Task Ledger 独立判定。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "complete_task_failure",
              "from": "running",
              "to": "failed",
              "trigger": "已开始的 Task 最终未满足成功条件",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/runtime-event",
                "orbit.concept/result-package"
              ],
              "guard": "所有失败 Attempt、Lease、Grant 和清理事实必须闭合且不可覆盖。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "cancel_running_task",
              "from": "running",
              "to": "cancelled",
              "trigger": "运行中收到有效取消信号",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/worker-lease",
                "orbit.concept/execution-grant"
              ],
              "guard": "先传播取消并闭合 Lease、Grant、结果与清理状态。",
              "emits": [
                "orbit.concept/runtime-event",
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "requeue_paused_task",
              "from": "paused",
              "to": "queued",
              "trigger": "恢复条件满足但需要新 Lease 或新 Invocation",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/policy",
                "orbit.concept/execution-grant"
              ],
              "guard": "检查 Grant、预算、期限和副作用幂等性；无需扩大 scope。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "resume_paused_task",
              "from": "paused",
              "to": "running",
              "trigger": "同一有效 Composition 可从检查点安全恢复",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/runtime-composition",
                "orbit.concept/worker-lease",
                "orbit.concept/execution-grant"
              ],
              "guard": "只在原批准范围内恢复，不因 paused 创建新人工门禁。",
              "emits": [
                "orbit.concept/runtime-event",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "fail_paused_task",
              "from": "paused",
              "to": "failed",
              "trigger": "恢复条件永久不可满足或安全闭合判定失败",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/policy"
              ],
              "guard": "保留暂停原因、已开始 Attempt 和终态闭合证据。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "cancel_paused_task",
              "from": "paused",
              "to": "cancelled",
              "trigger": "暂停期间收到有效取消信号",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "撤销剩余 Grant、Lease 和临时资源并保留检查点证据。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "cancel_draft_task",
              "from": "draft",
              "to": "cancelled",
              "trigger": "Task 在派发前被撤回",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "不产生 Grant 或运行事实。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "cancel_details_task",
              "from": "need_details",
              "to": "cancelled",
              "trigger": "待补充 Task 被撤回或超期关闭",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "保留缺失信息原因。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "cancel_pending_task",
              "from": "pending_approval",
              "to": "cancelled",
              "trigger": "待审批 Task 被责任人撤回或超期关闭",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "取消不伪造 rejected ApprovalDecision。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            }
          ],
          "view_transition_ids": [
            "request_task_details",
            "complete_task_details",
            "wait_for_task_approval",
            "queue_task_without_approval",
            "queue_approved_task",
            "reject_task_approval",
            "start_queued_task",
            "pause_running_task",
            "resume_paused_task",
            "complete_task_success",
