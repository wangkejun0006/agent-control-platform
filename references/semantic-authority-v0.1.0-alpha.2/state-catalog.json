              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/policy",
                "orbit.concept/route",
                "orbit.concept/execution-grant"
              ],
              "guard": "Route 与 Grant 必须绑定同一 Task、Release、环境、预算和期限。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "queue_approved_task",
              "from": "pending_approval",
              "to": "queued",
              "trigger": "收到精确 Task scope 的有效 ApprovalDecision",
              "transition_control": "human_decision",
              "decision_scope": "task_execution_approval",
              "required_refs": [
                "orbit.concept/approval-decision",
                "orbit.concept/route",
                "orbit.concept/execution-grant"
              ],
              "guard": "复用本 Task 唯一审批范围；参数或 scope 实质变化必须返回 draft 重新计算。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "reject_task_approval",
              "from": "pending_approval",
              "to": "rejected",
              "trigger": "精确 Task scope 被人类拒绝",
              "transition_control": "human_decision",
              "decision_scope": "task_execution_approval",
              "required_refs": [
                "orbit.concept/approval-decision"
              ],
              "guard": "拒绝保持可审计，不能转换成失败或由重试覆盖。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "start_queued_task",
              "from": "queued",
              "to": "running",
              "trigger": "有效 WorkerLease 与 AgentInvocation 被接受",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/execution-grant",
                "orbit.concept/runtime-composition",
                "orbit.concept/worker-lease",
                "orbit.concept/agent-invocation"
              ],
              "guard": "Preflight 通过且 Grant 未撤销、过期或消费；不新增人工门禁。",
