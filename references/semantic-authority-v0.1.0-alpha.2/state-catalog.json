              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "撤销未消费 Grant 和 Lease，并保留取消来源。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "pause_running_task",
              "from": "running",
              "to": "paused",
              "trigger": "预算、Policy、人工接管或可恢复故障要求暂停",
