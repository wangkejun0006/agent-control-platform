{
  "catalog_version": "orbit.architecture-state-catalog/1",
  "catalog_id": "orbit-company-agent-formal-states",
  "status": "human_confirmed",
  "definition_authority": "orbit-agent-architecture",
  "concept_catalog": {
    "version": "orbit.architecture-concept-catalog/2",
    "path": "architecture/authority/concepts/concept-catalog.json"
  },
  "term_registry": {
    "version": "orbit.architecture-term-classification/2",
    "path": "architecture/authority/terms/term-classification.json"
  },
  "vocabulary_rule": "优先复用 Contract 与状态机领域常用词；active 表示长期可用，approved 表示精确范围获批，running 表示正在执行，suspended 表示长期对象停用，paused 表示可恢复任务暂停，blocked 表示生效前被阻止，failed 表示已开始后失败。",
  "machines": [
    {
      "id": "orbit.state/agent-lifecycle",
      "term_zh": "Agent 生命周期",
      "term_en": "Agent Lifecycle",
      "publication_stage": "release",
      "evidence_status": "human_confirmed",
      "machine_kind": "lifecycle",
      "subject_refs": [
        "orbit.concept/agent"
      ],
      "definition": "描述 Agent 业务身份从设计、评测、可接收任务、暂停到永久退役的公司级生命周期；状态转换本身不产生 Task 权限。",
      "instance_state_authority": "Agent Registry 与 Agent Lifecycle Ledger",
      "dimensions": [
        {
          "id": "lifecycle",
          "term_zh": "生命周期",
          "term_en": "Lifecycle",
          "initial_states": [
            "draft"
          ],
          "terminal_states": [
            "retired"
          ],
          "states": [
            {
              "id": "draft",
              "term_zh": "草拟",
              "term_en": "Draft",
              "definition": "Agent 已有候选身份、Owner 与评测计划，但只能进行设计和离线准备。",
              "not_a": [
                "不是可接收正式 Task 的 active Agent",
                "不是未登记的自然语言角色"
              ]
            },
            {
              "id": "evaluation",
              "term_zh": "评测中",
              "term_en": "Evaluation",
              "definition": "Agent 正在隔离环境内针对精确 Release 运行资格、安全和能力评测。",
              "not_a": [
                "不是 active",
                "不是 production authorized"
              ]
            },
            {
              "id": "active",
              "term_zh": "活动",
              "term_en": "Active",
              "definition": "Agent 业务身份可在已批准边界内接收新 Task，但每次执行仍需独立 Task 与 ExecutionGrant。",
              "not_a": [
                "不是有效 ExecutionGrant",
                "不是 Deployment running"
              ]
            },
            {
              "id": "suspended",
              "term_zh": "已暂停",
              "term_en": "Suspended",
              "definition": "Agent 暂停接收新 Task 和新 Grant，历史身份与证据继续保留。",
              "not_a": [
                "不是 retired",
                "不是某个 Task 的 paused"
              ]
            },
            {
              "id": "retired",
              "term_zh": "已退役",
              "term_en": "Retired",
              "definition": "Agent 永久停止新增运行能力，身份 ID、历史 Release、决定和审计引用继续保留。",
              "not_a": [
                "不是可恢复的 suspended",
                "不是删除历史证据"
              ]
            }
          ],
          "transitions": [
            {
              "id": "submit_for_evaluation",
              "from": "draft",
              "to": "evaluation",
              "trigger": "候选与最小评测计划结构闭合",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/agent-release",
                "orbit.concept/evaluation-report"
              ],
              "guard": "只允许隔离评测，不创建生产 Task、Grant 或部署事实。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "return_for_revision",
              "from": "evaluation",
              "to": "draft",
              "trigger": "评测发现需要修改的候选缺口",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/evaluation-report"
              ],
              "guard": "保留失败评测；实现或边界变化形成新的不可变 Release。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "activate_stable_agent",
              "from": "evaluation",
              "to": "active",
              "trigger": "稳定 Agent 的精确 Release 通过评测并获激活决定",
              "transition_control": "human_decision",
              "decision_scope": "agent_activation",
              "required_refs": [
                "orbit.concept/agent-release",
                "orbit.concept/evaluation-report",
                "orbit.concept/approval-decision"
              ],
              "guard": "ApprovalDecision 必须绑定精确 Agent、Release digest、环境、scope 与有效期。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "activate_template_task_agent",
              "from": "evaluation",
              "to": "active",
              "trigger": "批准 Template 下的临时 Task Agent 通过确定性子集证明",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/agent-template",
                "orbit.concept/task",
                "orbit.concept/policy",
                "orbit.concept/approval-decision"
              ],
              "guard": "Capability、权限、预算、期限、数据等级、委派深度与审批义务均不宽于父 Task 和已批准 Template。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "suspend_agent",
              "from": "active",
              "to": "suspended",
              "trigger": "风险、Owner 缺失、撤权或紧急停止条件成立",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/policy"
              ],
              "guard": "停止新 Task 与新 Grant；运行中 Task 按其独立状态和风险处理。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "resume_evaluation",
              "from": "suspended",
              "to": "evaluation",
              "trigger": "修复完成并申请重新评测",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/evaluation-report",
                "orbit.concept/policy"
              ],
              "guard": "恢复前重新评测，不能直接从 suspended 回到 active。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "retire_active_agent",
              "from": "active",
              "to": "retired",
              "trigger": "责任人决定永久退役活动 Agent",
              "transition_control": "human_decision",
              "decision_scope": "agent_retirement",
              "required_refs": [
                "orbit.concept/approval-decision"
              ],
              "guard": "撤销运行能力并保留身份、Release、决定与审计引用。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "retire_suspended_agent",
              "from": "suspended",
              "to": "retired",
              "trigger": "责任人决定不再恢复已暂停 Agent",
              "transition_control": "human_decision",
              "decision_scope": "agent_retirement",
              "required_refs": [
                "orbit.concept/approval-decision"
              ],
              "guard": "不得删除或改写暂停前的失败、撤权和审计证据。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            }
          ],
          "view_transition_ids": [
            "submit_for_evaluation",
            "return_for_revision",
            "activate_stable_agent",
            "activate_template_task_agent",
            "suspend_agent",
            "resume_evaluation",
            "retire_active_agent",
            "retire_suspended_agent"
          ]
        }
      ],
      "architecture_refs": [
        "architecture/supporting/governance/agent-governance.md",
        "architecture/supporting/decisions/0013-agent-lifecycle-automation-and-assurance.md",
        "architecture/supporting/decisions/0017-formal-state-authority.md"
      ],
      "contract_refs": [
        {
          "path": "contracts/schemas/agent-registry.schema.json",
          "publication_stage": "release",
          "alignment": "partial",
          "gap": "状态枚举一致；转换、人工决定范围、registration-only 组合语义由本 State 目录领先定义。"
        }
      ],
      "view_projections": [
        {
          "path": "architecture/views/control-plane-governed-loop-overview.md",
          "block_id": "agent-lifecycle"
        },
        {
          "path": "architecture/views/agent-management-deployment-plan.md",
          "block_id": "management-agent-lifecycle"
        }
      ],
      "invariants": [
        "draft 与 evaluation 合称 registration-only；active 也不能替代 Task、ApprovalDecision 或 ExecutionGrant。"
      ]
    },
    {
      "id": "orbit.state/agent-release-lifecycle",
      "term_zh": "Agent Release 生命周期",
      "term_en": "Agent Release Lifecycle",
      "publication_stage": "release",
      "evidence_status": "human_confirmed",
      "machine_kind": "lifecycle",
      "subject_refs": [
        "orbit.concept/agent-release"
      ],
      "definition": "描述不可变 Agent Release 候选从草拟、评测、批准、暂停到退役的状态；不把 Release 资格转换为 Agent 激活或执行授权。",
      "instance_state_authority": "Agent Registry 与 Agent Release Lifecycle Ledger",
      "dimensions": [
        {
          "id": "lifecycle",
          "term_zh": "生命周期",
          "term_en": "Lifecycle",
          "initial_states": [
            "draft"
          ],
          "terminal_states": [
            "retired"
          ],
          "states": [
            {
              "id": "draft",
              "term_zh": "草拟",
              "term_en": "Draft",
              "definition": "精确 Release 候选正在闭合摘要、依赖与评测输入。",
              "not_a": [
                "不是 approved",
                "不是可变更已发布 Release"
              ]
            },
            {
              "id": "evaluation",
              "term_zh": "评测中",
              "term_en": "Evaluation",
              "definition": "正在针对同一不可变 Release digest 运行资格和独立评测。",
              "not_a": [
                "不是 Agent evaluation 状态",
                "不是 approved"
              ]
            },
            {
              "id": "approved",
              "term_zh": "已批准",
              "term_en": "Approved",
              "definition": "精确 Release digest 在声明的评测和责任范围内获得批准，可被 Agent 生命周期引用。",
              "not_a": [
                "不是 Agent active",
                "不是 Deployment running 或有效 Grant"
              ]
            },
            {
              "id": "suspended",
              "term_zh": "已暂停",
              "term_en": "Suspended",
              "definition": "Release 因风险、依赖或证据变化暂停用于新激活和新 Task。",
              "not_a": [
                "不是 retired",
                "不是 Task paused"
              ]
            },
            {
              "id": "retired",
              "term_zh": "已退役",
              "term_en": "Retired",
              "definition": "Release 永久停止用于新激活和新 Task，摘要和历史证据继续保留。",
              "not_a": [
                "不是删除 Release",
                "不是可恢复的 suspended"
              ]
            }
          ],
          "transitions": [
            {
              "id": "submit_release_evaluation",
              "from": "draft",
              "to": "evaluation",
              "trigger": "候选摘要和评测输入闭合",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/agent-release",
                "orbit.concept/evaluation-report"
              ],
              "guard": "评测始终绑定同一不可变 Release digest。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "abandon_draft_release",
              "from": "draft",
              "to": "retired",
              "trigger": "候选被放弃或由新候选取代",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/agent-release"
              ],
              "guard": "保留候选摘要和取代关系，不生成 approved 结论。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "approve_release",
              "from": "evaluation",
              "to": "approved",
              "trigger": "精确 Release 通过门槛并获得发布范围决定",
              "transition_control": "human_decision",
              "decision_scope": "agent_release_approval",
              "required_refs": [
                "orbit.concept/evaluation-report",
                "orbit.concept/approval-decision"
              ],
              "guard": "决定只覆盖精确 Release digest、评测范围、环境和有效期。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "close_failed_release_evaluation",
              "from": "evaluation",
              "to": "retired",
              "trigger": "评测失败、撤回或候选被取代",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/evaluation-report"
              ],
              "guard": "失败保持失败；修复形成新 Release，不返回修改原候选。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "suspend_release",
              "from": "approved",
              "to": "suspended",
              "trigger": "风险、依赖、撤权或证据退化条件成立",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/policy"
              ],
              "guard": "立即停止该 Release 的新激活和新 Task，不改写历史使用证据。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "reevaluate_suspended_release",
              "from": "suspended",
              "to": "evaluation",
              "trigger": "同一不可变 Release 申请重新评测",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/evaluation-report",
                "orbit.concept/policy"
              ],
              "guard": "内容摘要变化必须形成新 Release；只有未变字节可重新评测。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "retire_approved_release",
              "from": "approved",
              "to": "retired",
              "trigger": "责任人决定永久停止已批准 Release 的新增使用",
              "transition_control": "human_decision",
              "decision_scope": "agent_release_retirement",
              "required_refs": [
                "orbit.concept/approval-decision"
              ],
              "guard": "保留 Release、评测、批准和历史 Task 引用。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "retire_suspended_release",
              "from": "suspended",
              "to": "retired",
              "trigger": "责任人决定不再恢复已暂停 Release",
              "transition_control": "human_decision",
              "decision_scope": "agent_release_retirement",
              "required_refs": [
                "orbit.concept/approval-decision"
              ],
              "guard": "不得删除或转换原暂停与失败证据。",
              "emits": [
                "orbit.concept/receipt",
                "orbit.concept/audit-event"
              ]
            }
          ],
          "view_transition_ids": [
            "submit_release_evaluation",
            "abandon_draft_release",
            "approve_release",
            "close_failed_release_evaluation",
            "suspend_release",
            "reevaluate_suspended_release",
            "retire_approved_release",
            "retire_suspended_release"
          ]
        }
      ],
      "architecture_refs": [
        "architecture/supporting/models/execution-contract-model.md",
        "architecture/supporting/decisions/0011-release-and-execution-contracts.md",
        "architecture/supporting/decisions/0017-formal-state-authority.md"
      ],
      "contract_refs": [
        {
          "path": "contracts/schemas/agent-release-manifest.schema.json",
          "publication_stage": "release",
          "alignment": "partial",
          "gap": "状态名称一致；转换、人工决定范围和不可变失败处理由本 State 目录领先定义。"
        }
      ],
      "view_projections": [
        {
          "path": "architecture/views/control-plane-governed-loop-overview.md",
          "block_id": "agent-release-lifecycle"
        }
      ],
      "invariants": [
        "approved 只表示精确 Release 范围获批，不自动产生 Agent active、Deployment running 或 ExecutionGrant。"
      ]
    },
    {
      "id": "orbit.state/task-lifecycle",
      "term_zh": "Task 生命周期",
      "term_en": "Task Lifecycle",
      "publication_stage": "release",
      "evidence_status": "human_confirmed",
      "machine_kind": "workflow",
      "subject_refs": [
        "orbit.concept/task"
      ],
      "definition": "描述公司 Task Ledger 中目标补充、审批等待、排队、运行、暂停和终态；Lease、Invocation、Evaluation 与 Receipt 保持独立对象。",
      "instance_state_authority": "Control Plane Task Ledger",
      "dimensions": [
        {
          "id": "lifecycle",
          "term_zh": "生命周期",
          "term_en": "Lifecycle",
          "initial_states": [
            "draft"
          ],
          "terminal_states": [
            "succeeded",
            "failed",
            "rejected",
            "cancelled"
          ],
          "states": [
            {
              "id": "draft",
              "term_zh": "草拟",
              "term_en": "Draft",
              "definition": "Task 已建立但目标、输入或约束尚未完成确定性检查。",
              "not_a": [
                "不是 queued",
                "不是已获 Grant"
              ]
            },
            {
              "id": "need_details",
              "term_zh": "待补充",
              "term_en": "Need Details",
              "definition": "Task 缺少继续授权计算所需的目标、输入、责任或边界信息。",
              "not_a": [
                "不是 rejected",
                "不是人工审批状态"
              ]
            },
            {
              "id": "pending_approval",
              "term_zh": "待审批",
              "term_en": "Pending Approval",
              "definition": "Policy 已确定本 Task 需要一个精确的人类决定，Task 等待该既有审批范围。",
              "not_a": [
                "不是 approved",
                "不是新增多重门禁"
              ]
            },
            {
              "id": "queued",
              "term_zh": "已排队",
              "term_en": "Queued",
              "definition": "Task 已满足派发前置条件，等待符合条件的 Worker 与 Lease。",
              "not_a": [
                "不是 leased 状态",
                "不是 running"
              ]
            },
            {
              "id": "running",
              "term_zh": "运行中",
              "term_en": "Running",
              "definition": "至少一个受控 Attempt 正在有效 Grant、Composition 和 Lease 边界内运行。",
              "not_a": [
                "不是 RuntimeEvent completed",
                "不是 succeeded"
              ]
            },
            {
              "id": "paused",
              "term_zh": "已暂停",
              "term_en": "Paused",
              "definition": "Task 暂停继续推进，可在预算、Policy、Grant 和检查点重新满足后恢复。",
              "not_a": [
                "不是 Agent suspended",
                "不是 terminal"
              ]
            },
            {
              "id": "succeeded",
              "term_zh": "成功",
              "term_en": "Succeeded",
              "definition": "Task Ledger 已根据结果契约和最低评价要求判定任务成功。",
              "not_a": [
                "不是单纯 Runtime completed",
                "不是人类接受"
              ]
            },
            {
              "id": "failed",
              "term_zh": "失败",
              "term_en": "Failed",
              "definition": "Task 已开始执行但最终未满足成功条件，并已保留失败 Attempt 与证据。",
              "not_a": [
                "不是生效前 blocked",
                "不是可覆盖的历史"
              ]
            },
            {
              "id": "rejected",
              "term_zh": "已拒绝",
              "term_en": "Rejected",
              "definition": "Task 在执行前因精确审批拒绝或不可满足的 Policy 边界而终止。",
              "not_a": [
                "不是运行后 failed",
                "不是 paused"
              ]
            },
            {
              "id": "cancelled",
              "term_zh": "已取消",
              "term_en": "Cancelled",
              "definition": "Task 按责任人、Policy 或父 Task 终止信号结束，并完成必要清理。",
              "not_a": [
                "不是 rejected",
                "不是自动删除结果"
              ]
            }
          ],
          "transitions": [
            {
              "id": "request_task_details",
              "from": "draft",
              "to": "need_details",
              "trigger": "确定性检查发现必要信息缺失",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "只请求完成授权计算所必需的信息，不扩大 Task Purpose。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "complete_task_details",
              "from": "need_details",
              "to": "draft",
              "trigger": "缺失信息已补齐并形成新 Task Revision",
              "transition_control": "automatic",
              "required_refs": [
                "orbit.concept/task"
              ],
              "guard": "保留前一 Revision 与补充来源。",
              "emits": [
                "orbit.concept/audit-event"
              ]
            },
            {
              "id": "wait_for_task_approval",
              "from": "draft",
              "to": "pending_approval",
              "trigger": "Policy 判定本 Task 需要人类决定",
              "transition_control": "policy_checked",
              "required_refs": [
                "orbit.concept/policy"
              ],
              "guard": "只创建一个与 Task 精确 scope 对应的待审批状态，不复制其他发布或激活门禁。",
              "emits": [
