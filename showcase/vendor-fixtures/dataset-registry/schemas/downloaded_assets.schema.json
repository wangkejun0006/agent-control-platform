{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.local/schemas/downloaded_assets.schema.json",
  "title": "Orbit Downloaded Assets Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "generated_at",
    "generator",
    "registry",
    "asset_count",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "downloaded-assets/v1"
    },
    "catalog_id": {
      "$ref": "#/$defs/sha256"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "const": "orbit_dataset_acquisition_registry"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "dataset_count"],
      "properties": {
        "path": {
          "const": "registry/catalog.integrated.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "asset_count": {
      "type": "integer",
      "minimum": 0
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "dataset_id",
        "name",
        "source",
        "release",
        "location",
        "state",
        "integrity",
        "governance",
        "modalities",
        "entity_keys",
        "default_eligibility"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset:[a-z0-9_-]+:raw:[A-Za-z0-9._-]+$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "url"],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "latest_version",
            "is_latest",
            "checked_at",
            "source_url",
            "manifest_url"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/nullableString"
            },
            "latest_version": {
              "$ref": "#/$defs/nullableString"
            },
            "is_latest": {
              "type": ["boolean", "null"]
            },
            "checked_at": {
              "$ref": "#/$defs/nullableString"
            },
            "source_url": {
              "$ref": "#/$defs/nullableString"
            },
            "manifest_url": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logical_key",
            "physical_uri",
            "storage_backend",
            "storage_class",
            "storage_volume_id",
            "layout"
          ],
          "properties": {
            "logical_key": {
              "type": "string",
              "pattern": "^dataset/[a-z0-9_-]+/raw/[A-Za-z0-9._-]+$"
            },
            "physical_uri": {
              "type": "string",
              "minLength": 1
            },
            "storage_backend": {
              "type": "string",
              "minLength": 1
            },
            "storage_class": {
              "$ref": "#/$defs/nullableString"
            },
            "storage_volume_id": {
              "$ref": "#/$defs/nullableString"
            },
            "layout": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_stage",
            "download_status",
            "file_count",
            "total_bytes",
            "updated_at"
          ],
          "properties": {
            "asset_stage": {
              "type": "string",
              "enum": [
                "registered",
                "queued",
                "downloading",
                "download_partial",
                "downloaded_raw",
                "locally_validated",
                "source_complete",
                "raw_verified",
                "export_pending",
                "exported",
                "archived_to_nas",
                "local_deleted",
                "failed",
                "update_available",
                "unknown"
              ]
            },
            "download_status": {
              "type": "string",
              "minLength": 1
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "updated_at": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_checks_passed",
            "evidence",
            "method",
            "source_scope",
            "report_uri",
            "report_sha256"
          ],
          "properties": {
            "all_checks_passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "source_scope": {
              "$ref": "#/$defs/nullableString"
            },
            "report_uri": {
              "$ref": "#/$defs/nullableString"
            },
            "report_sha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "license_name",
            "data_usage_agreement",
            "commercial_use",
            "credential_required",
            "legal_compliance",
            "review_status"
          ],
          "properties": {
            "license_name": {
              "type": "string",
              "minLength": 1
            },
            "data_usage_agreement": {
              "type": "string"
            },
            "commercial_use": {
              "type": "string",
              "enum": ["Allowed", "Restricted", "Prohibited", "Unknown"]
            },
            "credential_required": {
              "type": "boolean"
            },
            "legal_compliance": {
              "$ref": "#/$defs/stringArray"
            },
            "review_status": {
              "type": "string",
              "enum": ["approved", "review_required", "blocked", "unknown"]
            }
          }
        },
        "modalities": {
          "$ref": "#/$defs/stringArray"
        },
        "entity_keys": {
          "$ref": "#/$defs/stringArray"
        },
        "default_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checks", "reasons"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["eligible", "review_required", "blocked"]
            },
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw_verified",
                "integrity_passed",
                "location_declared",
                "release_identified",
                "integrity_evidence_bound",
                "governance_approved"
              ],
              "properties": {
                "raw_verified": { "type": "boolean" },
                "integrity_passed": { "type": "boolean" },
                "location_declared": { "type": "boolean" },
                "release_identified": { "type": "boolean" },
                "integrity_evidence_bound": { "type": "boolean" },
                "governance_approved": { "type": "boolean" }
              }
            },
            "reasons": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      }
    }
  }
}

