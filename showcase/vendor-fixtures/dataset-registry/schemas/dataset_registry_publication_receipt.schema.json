{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:data-asset:dataset-registry-publication-receipt:0.1",
  "title": "Dataset Registry Publication Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "patch_ref",
    "previous_registry_revision_ref",
    "resulting_registry_revision_ref",
    "status",
    "derived_sync_status",
    "rollback_performed",
    "synthetic"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "receipt_id": { "type": "string", "pattern": "^pubrcpt_[a-z0-9][a-z0-9_-]{2,95}$" },
    "patch_ref": { "type": "string", "pattern": "^receipt://registry-patch/[A-Za-z0-9._:-]+$" },
    "previous_registry_revision_ref": { "type": "string", "pattern": "^registry://revision/sha256/[a-f0-9]{64}$" },
    "resulting_registry_revision_ref": { "type": "string", "pattern": "^registry://revision/sha256/[a-f0-9]{64}$" },
    "status": { "enum": ["published", "conflict", "rejected", "rolled_back"] },
    "derived_sync_status": { "enum": ["not_requested", "verified", "failed"] },
    "rollback_performed": { "type": "boolean" },
    "failure_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" },
    "synthetic": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["conflict", "rejected", "rolled_back"] } }, "required": ["status"] },
      "then": { "required": ["failure_code"] }
    }
  ]
}

