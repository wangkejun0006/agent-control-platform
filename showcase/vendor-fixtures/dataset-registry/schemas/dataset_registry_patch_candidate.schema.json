{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:data-asset:dataset-registry-patch-candidate:0.1",
  "title": "Dataset Registry Patch Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "task_ref",
    "execution_grant_ref",
    "expected_registry_revision_ref",
    "operations",
    "idempotency_key",
    "classification"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "patch_id": { "type": "string", "pattern": "^patch_[a-z0-9][a-z0-9_-]{2,95}$" },
    "task_ref": { "type": "string", "pattern": "^task_[a-z0-9][a-z0-9_-]{2,95}$" },
    "execution_grant_ref": { "type": "string", "pattern": "^grant_[a-z0-9][a-z0-9_-]{2,95}$" },
    "expected_registry_revision_ref": { "type": "string", "pattern": "^registry://revision/sha256/[a-f0-9]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "dataset_ref", "acquisition_receipt_ref", "artifact_ref", "content_sha256", "size_bytes"],
        "properties": {
          "operation": { "const": "bind_acquired_artifact" },
          "dataset_ref": { "type": "string", "pattern": "^dataset://[a-z0-9][a-z0-9._/-]{1,159}$" },
          "acquisition_receipt_ref": { "type": "string", "pattern": "^receipt://acquisition/[A-Za-z0-9._:-]+$" },
          "artifact_ref": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._:/-]+$" },
          "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$" },
    "classification": { "enum": ["synthetic", "public", "internal", "confidential", "wearable_restricted", "medical_restricted"] }
  }
}

