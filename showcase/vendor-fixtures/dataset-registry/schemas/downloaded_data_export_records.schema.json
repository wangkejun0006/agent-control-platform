{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleep-ai.local/schemas/downloaded_data_export_records.schema.json",
  "title": "Downloaded Data Export Record Shapes",
  "type": "object",
  "anyOf": [
    { "$ref": "#/$defs/rag_chunk" },
    { "$ref": "#/$defs/text_pretrain" },
    { "$ref": "#/$defs/sft_message" },
    { "$ref": "#/$defs/physiological_window" },
    { "$ref": "#/$defs/ehr_event_sequence" },
    { "$ref": "#/$defs/layer_a" },
    { "$ref": "#/$defs/sixd_summary" },
    { "$ref": "#/$defs/health_report" },
    { "$ref": "#/$defs/analyze_run" },
    { "$ref": "#/$defs/red_line_event" },
    { "$ref": "#/$defs/red_line_rule" },
    { "$ref": "#/$defs/audit_record" },
    { "$ref": "#/$defs/oi_gate_decision" },
    { "$ref": "#/$defs/ringfm_run" },
    { "$ref": "#/$defs/ringfm_gap" },
    { "$ref": "#/$defs/knowledge_entry" },
    { "$ref": "#/$defs/agent_trajectory" }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["dataset_id"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-]+$"
        }
      },
      "additionalProperties": true
    },
    "rag_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "metadata"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "text_pretrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "metadata"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "sft_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "metadata"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant"]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "physiological_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "subject_id",
        "session_id",
        "window_start",
        "window_end",
        "channel",
        "sampling_rate",
        "values",
        "label",
        "metadata"
      ],
      "properties": {
        "dataset_id": { "type": "string" },
        "subject_id": { "type": "string" },
        "session_id": { "type": "string" },
        "window_start": { "type": ["string", "number"] },
        "window_end": { "type": ["string", "number"] },
        "channel": { "type": "string" },
        "sampling_rate": { "type": ["number", "string"] },
        "values": {
          "oneOf": [
            { "$ref": "#/$defs/number_array" },
            { "type": "string", "contentEncoding": "base64" }
          ]
        },
        "label": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "ehr_event_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "events", "metadata"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["time", "type"],
            "additionalProperties": true,
            "properties": {
              "time": { "type": "string" },
              "type": { "type": "string" },
              "code": { "type": ["string", "null"] },
              "text": { "type": ["string", "null"] }
            }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "layer_a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "user_id_hash",
        "night_start",
        "data_level",
        "epoch_minutes",
        "metadata"
      ],
      "anyOf": [
        { "required": ["series"] },
        { "required": ["series_summary"] }
      ],
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "user_id_hash": { "type": "string", "minLength": 1 },
        "night_start": { "type": "string" },
        "data_level": {
          "type": "string",
          "enum": ["raw", "processed", "validated"]
        },
        "epoch_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "seq_len": { "type": "integer", "minimum": 1 },
        "firmware": { "type": ["string", "null"] },
        "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "wearing_status": { "type": ["string", "null"] },
        "series": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hr": { "$ref": "#/$defs/number_array" },
            "hrv": { "$ref": "#/$defs/number_array" },
            "skin_temp": { "$ref": "#/$defs/number_array" },
            "rr": { "$ref": "#/$defs/number_array" },
            "spo2": { "$ref": "#/$defs/number_array" },
            "actigraphy": { "$ref": "#/$defs/number_array" }
          },
          "minProperties": 1
        },
        "series_summary": {
          "type": "object",
          "additionalProperties": true,
          "required": ["channels"],
          "properties": {
            "channels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["hr", "hrv", "skin_temp", "rr", "spo2", "actigraphy"]
              },
              "minItems": 1
            },
            "nightly_mean": { "$ref": "#/$defs/number_array" },
            "nightly_std": { "$ref": "#/$defs/number_array" },
            "valid_fraction": { "$ref": "#/$defs/number_array" }
          }
        },
        "series_ref": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "sixd_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "subject_id",
        "session_id",
        "channels",
        "seq_len",
        "epoch_minutes",
        "values_ref",
        "quality_tier",
        "aggregates"
      ],
      "properties": {
        "dataset_id": { "type": "string" },
        "subject_id": { "type": "string" },
        "session_id": { "type": "string" },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["hr", "hrv", "skin_temp", "rr", "spo2", "actigraphy"]
          }
        },
        "seq_len": { "type": "integer", "minimum": 1 },
        "epoch_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "values_ref": { "type": "string" },
        "quality_tier": {
          "type": "string",
          "enum": ["A", "B", "C", "reject"]
        },
        "aggregates": { "type": "object", "additionalProperties": true },
        "provenance": { "type": "object", "additionalProperties": true }
      }
    },
    "health_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata"],
      "anyOf": [
        { "required": ["text"] },
        { "required": ["summary"] }
      ],
      "properties": {
        "dataset_id": { "type": "string" },
        "subject_id": { "type": "string" },
        "session_id": { "type": "string" },
        "report_id": { "type": "string" },
        "run_id": { "type": ["string", "null"] },
        "user_id_hash": { "type": ["string", "null"] },
        "report_type": { "type": ["string", "null"], "enum": ["daily", "weekly", "monthly", null] },
        "disease_module": { "type": ["string", "null"] },
        "period_start": { "type": ["string", "null"] },
        "period_end": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 },
        "layer_e_snapshot": { "type": ["object", "null"], "additionalProperties": true },
        "layer_f_snapshot": { "type": ["object", "null"], "additionalProperties": true },
        "export_formats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "placeholder": { "type": ["boolean", "integer", "null"] },
        "created_at": { "type": ["string", "null"] },
        "text": { "type": "string", "minLength": 1 },
        "period": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "analyze_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "analyze_id": { "type": "string" },
        "run_id": { "type": "string", "minLength": 1 },
        "ingest_id": { "type": ["string", "null"] },
        "user_id_hash": { "type": ["string", "null"] },
        "subject_id": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "disease_module": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"], "enum": ["success", "partial", "error", null] },
        "snapshot_id": { "type": ["string", "null"] },
        "layer_e": { "type": ["object", "null"], "additionalProperties": true },
        "layer_f": { "type": ["object", "null"], "additionalProperties": true },
        "input_ref": { "type": ["string", "null"] },
        "output": { "type": "object", "additionalProperties": true },
        "error_message": { "type": ["string", "null"] },
        "processing_ms": { "type": ["integer", "null"], "minimum": 0 },
        "created_at": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "red_line_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "rule_id", "severity", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "event_id": { "type": "string", "minLength": 1 },
        "analyze_id": { "type": ["string", "null"] },
        "subject_id": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": ["string", "null"] },
        "severity": { "type": "string", "enum": ["info", "warning", "critical", "block"] },
        "message": { "type": ["string", "null"] },
        "clinical_signed": { "type": ["integer", "boolean", "null"] },
        "payload": { "type": ["object", "null"], "additionalProperties": true },
        "triggered_at": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "red_line_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "rule_id", "rule_version", "description", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "thresholds": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "audit_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "audit_id", "audit_type", "status", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "audit_id": { "type": "string", "minLength": 1 },
        "audit_type": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "warning", "fail", "pending"] },
        "details": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "oi_gate_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "decision", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "run_id": { "type": "string", "minLength": 1 },
        "gate_id": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["allow", "hold", "block"] },
        "reason": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] },
        "payload": { "type": ["object", "null"], "additionalProperties": true },
        "metrics": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "ringfm_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "ringfm_run_id": { "type": "string" },
        "run_id": { "type": "string", "minLength": 1 },
        "teacher_source": { "type": ["string", "null"] },
        "n_subjects": { "type": ["integer", "null"], "minimum": 0 },
        "n_diseases": { "type": ["integer", "null"], "minimum": 0 },
        "embed_dim": { "type": ["integer", "null"], "minimum": 1 },
        "spec": { "type": ["object", "null"], "additionalProperties": true },
        "result_summary": { "type": ["object", "null"], "additionalProperties": true },
        "rat_record_id": { "type": ["string", "null"] },
        "rat_record_hash": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["planned", "running", "completed", "failed"] },
        "metrics": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "ringfm_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ringfm_run_id", "metadata"],
      "properties": {
        "dataset_id": { "type": "string" },
        "ringfm_run_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": ["string", "null"] },
        "disease": { "type": ["string", "null"] },
        "disease_group": { "type": ["string", "null"] },
        "metric_name": { "type": ["string", "null"] },
        "value": { "type": ["number", "null"] },
        "c_index_teacher_full": { "type": ["number", "null"] },
        "c_index_teacher_ring": { "type": ["number", "null"] },
        "c_index_student": { "type": ["number", "null"] },
        "gap_modality": { "type": ["number", "null"] },
        "gap_student": { "type": ["number", "null"] },
        "ring_reachable": { "type": ["integer", "boolean", "null"] },
        "driver": { "type": ["string", "null"] },
        "baseline_value": { "type": ["number", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "knowledge_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "metadata"],
      "anyOf": [
        { "required": ["text"] },
        { "required": ["content_json"] }
      ],
      "properties": {
        "dataset_id": { "type": "string" },
        "entry_id": { "type": "string", "minLength": 1 },
        "layer": { "type": ["string", "null"], "enum": ["B", "C", null] },
        "domain": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "text": { "type": "string", "minLength": 1 },
        "content_json": { "type": ["object", "null"], "additionalProperties": true },
        "evidence_level": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "agent_trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "metadata"],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "additionalProperties": true,
            "properties": {
              "role": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        },
        "tool": { "type": ["string", "null"] },
        "observation": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "number_array": {
      "type": "array",
      "items": {
        "type": ["number", "null"]
      }
    }
  }
}

