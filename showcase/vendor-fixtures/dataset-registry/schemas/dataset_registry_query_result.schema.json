{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:data-asset:dataset-registry-query-result:0.1",
  "title": "Dataset Registry Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "request_ref",
    "registry_revision_ref",
    "result_kind",
    "dataset_refs",
    "changed_dataset_refs",
    "content_digest",
    "classification"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "receipt_id": { "type": "string", "pattern": "^qryrcpt_[a-z0-9][a-z0-9_-]{2,95}$" },
    "request_ref": { "type": "string", "pattern": "^receipt://query/[A-Za-z0-9._:-]+$" },
    "registry_revision_ref": { "type": "string", "pattern": "^registry://revision/sha256/[a-f0-9]{64}$" },
    "result_kind": { "enum": ["registry_query", "watchlist_snapshot", "watchlist_diff"] },
    "dataset_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dataset_ref" } },
    "snapshot_ref": { "type": "string", "pattern": "^snapshot://[A-Za-z0-9._:/-]+$" },
    "changed_dataset_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dataset_ref" } },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "classification": { "enum": ["synthetic", "public"] }
  },
  "$defs": {
    "dataset_ref": { "type": "string", "pattern": "^dataset://[a-z0-9][a-z0-9._/-]{1,159}$" }
  }
}

