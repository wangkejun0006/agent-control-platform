{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "公司级架构交换契约，不是实际任务队列配置。",
  "$id": "urn:company-ai-os:schema:task:0.3",
  "title": "Company AI OS Task",
  "description": "任务事实、授权上下文、预算和运行状态。不得包含真实密钥或存储路径。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "idempotency_key",
    "created_by",
    "accountable_human_id",
    "agent_id",
    "agent_version",
    "agent_definition_ref",
    "agent_binding_ref",
    "hierarchy_context",
    "purpose",
    "status",
    "risk_class",
    "autonomy_level",
    "input_refs",
    "dependency_snapshot_refs",
    "permission_request",
    "approval",
    "budget",
    "retry_policy",
    "result_contract_ref",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "task_id": {
      "$ref": "#/$defs/task_id"
    },
    "parent_task_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/task_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "human",
            "agent",
            "system"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "feishu_identity_ref": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "accountable_human_id": {
      "$ref": "#/$defs/human_id"
    },
    "agent_id": {
      "$ref": "#/$defs/agent_id"
    },
    "agent_version": {
      "$ref": "#/$defs/version"
    },
    "agent_definition_ref": {
      "$ref": "#/$defs/versioned_ref"
    },
    "agent_binding_ref": {
      "$ref": "#/$defs/versioned_ref"
    },
    "org_path": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      }
    },
    "hierarchy_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hierarchy_snapshot_ref",
        "accountability_org_node_id",
        "budget_org_node_id",
        "project_node_id",
        "membership_refs",
        "delegation_chain_refs",
        "effective_grant_refs",
        "approval_policy_refs"
      ],
      "properties": {
        "hierarchy_snapshot_ref": {
          "type": "string",
          "pattern": "^hsnap_[a-z0-9][a-z0-9_-]{2,79}$"
        },
        "accountability_org_node_id": {
          "type": "string",
          "pattern": "^hnode_[a-z0-9][a-z0-9_-]{2,79}$"
        },
        "budget_org_node_id": {
          "type": "string",
          "pattern": "^hnode_[a-z0-9][a-z0-9_-]{2,79}$"
        },
        "project_node_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hnode_[a-z0-9][a-z0-9_-]{2,79}$"
        },
        "membership_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^mbr_[a-z0-9][a-z0-9_-]{2,79}$"
          }
        },
        "delegation_chain_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dlg_[a-z0-9][a-z0-9_-]{2,79}$"
          }
        },
        "effective_grant_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^grant_[a-z0-9][a-z0-9_-]{2,79}$"
          }
        },
        "approval_policy_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^apol_[a-z0-9][a-z0-9_-]{2,79}$"
          }
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "draft",
        "need_details",
        "pending_approval",
        "queued",
        "running",
        "paused",
        "succeeded",
        "failed",
        "rejected",
        "cancelled"
      ]
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "autonomy_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlled_ref"
      }
    },
    "dependency_snapshot_refs": {
      "description": "任务创建时锁定的 Registry、数据、知识、策略、模型、Prompt、工具和已批准资产版本；禁止使用隐式 latest。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency_ref"
      }
    },
    "permission_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_operations",
        "dataset_requests",
        "knowledge_refs"
      ],
      "properties": {
        "tool_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tool_[a-z0-9_-]+:[a-z0-9_-]+$"
          }
        },
        "dataset_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_id",
              "version_id",
              "operation",
              "purpose"
            ],
            "properties": {
              "dataset_id": {
                "$ref": "#/$defs/dataset_id"
              },
              "version_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "operation": {
                "enum": [
                  "discover",
                  "read",
                  "query",
                  "aggregate",
                  "transform",
                  "export",
                  "train"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 10,
                "maxLength": 500
              },
              "scope_ref": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "knowledge_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state",
        "decision_refs"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "decision_refs": {
          "description": "不可变 ApprovalDecision 的引用；Task 中的 state 只是派生摘要。",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^decision_[a-z0-9][a-z0-9_-]{2,79}$"
          }
        },
        "approval_id": {
          "type": "string",
          "pattern": "^apr_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "approved_by_human_id": {
          "$ref": "#/$defs/human_id"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "max_runtime_seconds",
        "on_exhaustion"
      ],
      "properties": {
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "on_exhaustion": {
          "enum": [
            "pause",
            "stop",
            "request_approval"
          ]
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "side_effect_retry"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "side_effect_retry": {
          "enum": [
            "never",
            "idempotent_only",
            "human_approved"
          ]
        },
        "backoff_policy": {
          "enum": [
            "none",
            "fixed",
            "exponential"
          ]
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_adapter_ref",
        "runtime_realization_ref",
        "workload_identity_ref",
        "execution_grant_ref",
        "invocation_ref"
      ],
      "properties": {
        "runtime_adapter_ref": {
          "$ref": "#/$defs/versioned_ref"
        },
        "runtime_realization_ref": {
          "$ref": "#/$defs/versioned_ref"
        },
        "runtime_identity_ref": {
          "type": "string",
          "maxLength": 240
        },
        "workload_identity_ref": {
          "type": "string",
          "maxLength": 500
        },
        "execution_grant_ref": {
          "$ref": "#/$defs/versioned_ref"
        },
        "invocation_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9][a-z0-9_-]{1,78})$"
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "checkpoint_ref": {
          "type": "string",
          "maxLength": 500
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result_contract_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "result_package_ref": {
      "type": "string",
      "maxLength": 240
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_class": {
            "enum": [
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "risk_class"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "properties": {
              "required": {
                "const": true
              },
              "state": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "expired"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^tsk_[a-z0-9][a-z0-9_-]{7,79}$"
    },
    "human_id": {
      "type": "string",
      "pattern": "^hum_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^ds_[a-z0-9][a-z0-9_-]{2,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9][a-z0-9_-]{1,78})$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "dependency_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "authority_ref",
        "ref_id",
        "version"
      ],
      "properties": {
        "ref_type": {
          "enum": [
            "registry_revision",
            "dataset_version",
            "knowledge_version",
            "policy_version",
            "approved_asset_version",
            "model_version",
            "prompt_version",
            "tool_version",
            "agent_definition",
            "agent_binding",
            "runtime_adapter",
            "runtime_realization",
            "model_route",
            "execution_grant"
          ]
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "ref_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "not": {
            "enum": [
              "latest",
              "main",
              "head"
            ]
          }
        }
      }
    },
    "controlled_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id"
      ],
      "properties": {
        "ref_type": {
          "enum": [
            "message",
            "document",
            "artifact",
            "task",
            "dataset_metadata",
            "knowledge"
          ]
        },
        "ref_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "maxLength": 120
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "wearable_restricted",
            "medical_restricted"
          ]
        }
      }
    }
  }
}

