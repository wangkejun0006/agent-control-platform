{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "RemediationReceipt 证明失败候选被保留，并在已批准自动化包络内形成新的不可变 Attempt；它不复用或改写旧批准。",
  "$id": "urn:company-ai-os:schema:remediation-receipt:0.1",
  "title": "Company AI OS RemediationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "RemediationReceipt" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "run_id", "status", "evidence_status", "synthetic_only", "created_at"],
      "properties": {
        "receipt_id": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/id" },
        "run_id": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/id" },
        "status": { "enum": ["prepared", "verified", "rejected"] },
        "evidence_status": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/evidence_status" },
        "synthetic_only": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_policy", "failure", "predecessor", "successor", "changes", "invariant_proofs", "verification_receipt_refs", "approval_handling", "authority_boundary"],
      "properties": {
        "automation_policy": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/artifact_binding" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "reason_codes", "stage_receipt"],
          "properties": {
            "class": { "enum": ["engineering_compatibility", "deterministic_test_failure", "transient_runtime", "quality_candidate_revision"] },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/reason_code" }
            },
            "stage_receipt": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/artifact_binding" }
          }
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_id", "composition_digest", "runtime_source_digest", "terminal_status"],
          "properties": {
            "attempt_id": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/id" },
            "composition_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
            "runtime_source_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
            "terminal_status": { "enum": ["blocked", "failed", "cancelled"] }
          }
        },
        "successor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_id", "composition_digest", "runtime_source_digest", "status"],
          "properties": {
            "attempt_id": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/id" },
            "composition_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
            "runtime_source_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
            "status": { "const": "candidate" }
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_ref", "change_class", "before_digest", "after_digest", "reason"],
            "properties": {
              "component_ref": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/logical_ref" },
              "change_class": { "enum": ["implementation_fix", "adapter_fix", "harness_fix", "test_fix", "prompt_candidate_revision", "workflow_candidate_revision"] },
              "before_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
              "after_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
              "reason": { "type": "string", "minLength": 3, "maxLength": 500 }
            }
          }
        },
        "invariant_proofs": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["boundary", "before_digest", "after_digest", "unchanged"],
            "properties": {
              "boundary": { "enum": ["purpose", "owner", "agent_id", "capabilities", "tool_operations", "data_classification", "model_route", "endpoint_allowlist", "budget_ceiling", "isolation_profile", "external_side_effects"] },
              "before_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
              "after_digest": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/digest" },
              "unchanged": { "const": true }
            }
          }
        },
        "verification_receipt_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:company-ai-os:schema:automation-common:0.1#/$defs/artifact_binding" }
        },
        "approval_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_exact_execution_approval_reused", "machine_policy_decision_required", "new_human_approval_required"],
          "properties": {
            "prior_exact_execution_approval_reused": { "const": false },
            "machine_policy_decision_required": { "const": true },
            "new_human_approval_required": { "type": "boolean" }
          }
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["within_approved_remediation_envelope", "permission_expanded", "data_scope_expanded", "release_authorization"],
          "properties": {
            "within_approved_remediation_envelope": { "type": "boolean" },
            "permission_expanded": { "const": false },
            "data_scope_expanded": { "const": false },
            "release_authorization": { "const": false }
          }
        }
      }
    }
  }
}

