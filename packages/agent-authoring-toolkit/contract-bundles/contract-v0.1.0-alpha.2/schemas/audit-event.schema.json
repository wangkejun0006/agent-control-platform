{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "AuditEvent 是追加式、内容最小化的治理事件契约；它记录谁对什么做了什么以及依据，不承载原始敏感内容。",
  "$id": "urn:company-ai-os:schema:audit-event:0.1",
  "title": "Company AI OS AuditEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "AuditEvent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_event_id", "chain_ref", "sequence", "evidence_status", "synthetic_only", "occurred_at"],
      "properties": {
        "audit_event_id": { "type": "string", "pattern": "^audit_[a-z0-9][a-z0-9_-]{2,79}$" },
        "chain_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "evidence_status": { "enum": ["synthetic", "architecture_reference", "verified_runtime"] },
        "synthetic_only": { "type": "boolean" },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "action", "resource", "task_ref", "invocation_ref", "decision", "outcome", "reason_codes", "policy_refs", "trace_refs", "content_logging", "payload_ref", "classification", "integrity"],
      "properties": {
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["human", "agent", "workload", "system"] },
            "id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" }
          }
        },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+(?:\\.[a-z][a-z0-9_-]+)+$" },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
            "ref": { "type": "string", "minLength": 3, "maxLength": 240 }
          }
        },
        "task_ref": { "oneOf": [{ "type": "null" }, { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" }] },
        "invocation_ref": { "oneOf": [{ "type": "null" }, { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" }] },
        "decision": { "enum": ["allow", "deny", "require_approval", "observe", "revoke"] },
        "outcome": { "enum": ["succeeded", "failed", "blocked", "pending", "not_applicable"] },
        "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" } },
        "policy_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" } },
        "trace_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 240 } },
        "content_logging": { "enum": ["none", "metadata_only", "redacted"] },
        "payload_ref": { "type": "string", "minLength": 3, "maxLength": 240 },
        "classification": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/classification" },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previous_event_digest", "event_digest"],
          "properties": {
            "previous_event_digest": { "oneOf": [{ "type": "null" }, { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/digest" }] },
            "event_digest": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/digest" }
          }
        }
      }
    }
  }
}

