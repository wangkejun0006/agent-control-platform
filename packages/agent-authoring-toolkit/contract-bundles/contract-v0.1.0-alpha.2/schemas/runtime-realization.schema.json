{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "RuntimeRealization 描述 AgentBinding 到 Runtime 原生构造的映射；它不能扩大 Binding 或产生 Effective Grant。",
  "$id": "urn:company-ai-os:schema:runtime-realization:0.1",
  "title": "Company AI OS RuntimeRealization",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "RuntimeRealization" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realization_id", "version", "status", "evidence_status", "synthetic_only"],
      "properties": {
        "realization_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
        "status": { "enum": ["draft", "evaluation", "approved", "suspended", "retired"] },
        "evidence_status": { "enum": ["synthetic", "architecture_reference", "verified_runtime"] },
        "synthetic_only": { "type": "boolean" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_ref",
        "template_ref",
        "runtime_adapter_ref",
        "runtime_revision_ref",
        "runtime_family",
        "realization_kind",
        "native_identity",
        "communication",
        "mappings",
        "lifecycle",
        "isolation",
        "secret_refs",
        "limitations"
      ],
      "properties": {
        "binding_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "template_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
          ]
        },
        "runtime_adapter_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "runtime_revision_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "runtime_family": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "realization_kind": {
          "enum": ["persistent_profile", "delegated_child", "durable_worker", "remote_peer"]
        },
        "native_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "native_ref", "business_identity_authority"],
          "properties": {
            "kind": { "enum": ["named_profile", "task_derived_identity", "remote_service_identity"] },
            "native_ref": { "type": "string", "pattern": "^native_[a-z0-9][a-z0-9_-]{2,79}$" },
            "business_identity_authority": { "const": "agent_definition" }
          }
        },
        "communication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modes", "agent_operations", "peer_agent_refs", "task_state_authority", "delivery_semantics"],
          "properties": {
            "modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["in_process_delegation", "durable_task_board", "authenticated_run_api"] }
            },
            "agent_operations": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/agent_operation" }
            },
            "peer_agent_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" }
            },
            "task_state_authority": { "enum": ["company_task_ledger", "runtime_local_pilot"] },
            "delivery_semantics": { "enum": ["ephemeral_result", "durable_handoff", "at_least_once_idempotent"] }
          }
        },
        "mappings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_route_refs", "tool_request_names", "data_request_names", "memory_classes"],
          "properties": {
            "model_route_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
            },
            "tool_request_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" }
            },
            "data_request_names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" }
            },
            "memory_classes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["working", "episodic", "semantic", "procedural"] }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["persistence", "start_trigger", "cancellation", "restart_recovery", "cleanup_policy_ref"],
          "properties": {
            "persistence": { "enum": ["ephemeral", "task_scoped", "persistent"] },
            "start_trigger": { "enum": ["direct_call", "task_dispatch", "service_start"] },
            "cancellation": { "enum": ["cooperative", "forceful", "unsupported"] },
            "restart_recovery": { "enum": ["none", "result_delivery_only", "task_reclaim"] },
            "cleanup_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" }
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary", "filesystem", "network", "credentials", "memory"],
          "properties": {
            "boundary": { "enum": ["in_process", "logical_profile", "process", "container"] },
            "filesystem": { "enum": ["deny", "workspace_read_only", "workspace_bounded"] },
            "network": { "enum": ["deny", "allowlisted", "runtime_default"] },
            "credentials": { "enum": ["none", "profile_scoped", "service_scoped"] },
            "memory": { "enum": ["none", "profile_scoped", "task_scoped"] }
          }
        },
        "secret_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^secretref_[a-z0-9][a-z0-9_-]{2,79}$" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 240 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "realization_kind": { "const": "delegated_child" } }, "required": ["realization_kind"] },
          "then": { "properties": { "template_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" } } },
          "else": { "properties": { "template_ref": { "type": "null" } } }
        }
      ]
    }
  }
}

