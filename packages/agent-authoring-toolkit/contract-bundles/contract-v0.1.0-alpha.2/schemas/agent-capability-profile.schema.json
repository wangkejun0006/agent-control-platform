{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "AgentCapabilityProfile 是 AgentDefinition 的可发现、可路由能力投影，不复制 Prompt，也不授予调用权限。",
  "$id": "urn:company-ai-os:schema:agent-capability-profile:0.1",
  "title": "Company AI OS AgentCapabilityProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "AgentCapabilityProfile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "agent_id", "version", "status", "evidence_status", "synthetic_only"],
      "properties": {
        "profile_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "agent_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
        "status": { "enum": ["draft", "evaluation", "approved", "retired"] },
        "evidence_status": { "enum": ["synthetic", "architecture_reference", "verified_runtime"] },
        "synthetic_only": { "type": "boolean" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ref", "visibility", "interfaces", "limitations"],
      "properties": {
        "definition_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "visibility": { "enum": ["private", "company_internal", "allowlisted_external", "public"] },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interface_id",
              "capability",
              "input_contract_refs",
              "output_contract_refs",
              "invocation_modes",
              "side_effect",
              "allowed_data_classifications",
              "requires_human_approval",
              "required_model_capabilities"
            ],
            "properties": {
              "interface_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
              "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+(?:\\.[a-z][a-z0-9_-]+)+$" },
              "input_contract_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
              },
              "output_contract_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
              },
              "invocation_modes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["synchronous", "asynchronous_task", "streaming"] }
              },
              "side_effect": { "enum": ["none", "reversible", "idempotent", "non_idempotent"] },
              "allowed_data_classifications": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/classification" }
              },
              "requires_human_approval": { "type": "boolean" },
              "required_model_capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    }
  }
}

