{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "公司级架构交换契约，Manifest 本身不授予工具权限。",
  "$id": "urn:company-ai-os:schema:tool-manifest:0.3",
  "title": "Company AI OS Tool Manifest",
  "description": "工具按操作声明能力、风险、副作用、凭据、出站和审批。不得包含真实密钥。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "version",
    "display_name",
    "description",
    "owner",
    "status",
    "hierarchy_scope_refs",
    "operations",
    "runtime_constraints",
    "audit_policy",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^tool_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_id",
        "role"
      ],
      "properties": {
        "human_id": {
          "type": "string",
          "pattern": "^hum_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "evaluation",
        "active",
        "suspended",
        "retired"
      ]
    },
    "hierarchy_scope_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^hnode_[a-z0-9][a-z0-9_-]{2,79}$"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "description",
          "action_types",
          "risk_class",
          "input_schema_ref",
          "output_schema_ref",
          "side_effect",
          "idempotency",
          "approval",
          "credential_policy",
          "network_egress",
          "data_policy",
          "timeout_seconds"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "action_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write",
                "execute",
                "external_send",
                "publish",
                "delete",
                "destructive",
                "financial",
                "permission_change",
                "medical"
              ]
            }
          },
          "risk_class": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "input_schema_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "output_schema_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "side_effect": {
            "enum": [
              "none",
              "reversible",
              "irreversible",
              "unknown"
            ]
          },
          "idempotency": {
            "enum": [
              "required",
              "supported",
              "not_supported"
            ]
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "policy_ref"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "none",
                  "policy_based",
                  "human_per_action",
                  "two_human"
                ]
              },
              "policy_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          },
          "credential_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credential_ref",
              "delivery",
              "agent_visible"
            ],
            "properties": {
              "credential_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "delivery": {
                "enum": [
                  "gateway_managed",
                  "short_lived_token",
                  "workload_identity"
                ]
              },
              "agent_visible": {
                "const": false
              }
            }
          },
          "network_egress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "destination_refs"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "deny_all",
                  "allowlist"
                ]
              },
              "destination_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          },
          "data_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allowed_classifications",
              "allowed_security_zones",
              "output_classification"
            ],
            "properties": {
              "allowed_classifications": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/classification"
                }
              },
              "allowed_security_zones": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/security_zone"
                }
              },
              "output_classification": {
                "$ref": "#/$defs/classification"
              },
              "redaction_policy_ref": {
                "type": "string",
                "maxLength": 240
              }
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "retry_policy_ref": {
            "type": "string",
            "maxLength": 240
          },
          "rollback_operation_ref": {
            "type": "string",
            "maxLength": 240
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "risk_class": {
                  "enum": [
                    "high",
                    "critical"
                  ]
                }
              },
              "required": [
                "risk_class"
              ]
            },
            "then": {
              "properties": {
                "approval": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "enum": [
                        "human_per_action",
                        "two_human"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action_types": {
                  "type": "array",
                  "contains": {
                    "enum": [
                      "external_send",
                      "publish",
                      "delete",
                      "destructive",
                      "financial",
                      "permission_change",
                      "medical"
                    ]
                  }
                }
              },
              "required": [
                "action_types"
              ]
            },
            "then": {
              "properties": {
                "approval": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "enum": [
                        "human_per_action",
                        "two_human"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "runtime_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_environments",
        "sandbox_required"
      ],
      "properties": {
        "allowed_environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "development",
              "test",
              "staging",
              "production"
            ]
          }
        },
        "sandbox_required": {
          "type": "boolean"
        },
        "allowed_runtime_adapter_refs": {
          "description": "允许承载该工具的 Adapter 精确引用；空或缺省表示仍需由 Binding、Task 和 Policy 决定，不能按产品名隐式放行。",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref"
          }
        }
      }
    },
    "audit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_request",
        "record_decision",
        "record_receipt",
        "content_logging"
      ],
      "properties": {
        "record_request": {
          "const": true
        },
        "record_decision": {
          "const": true
        },
        "record_receipt": {
          "const": true
        },
        "content_logging": {
          "enum": [
            "none",
            "metadata_only",
            "redacted"
          ]
        },
        "retention_policy_ref": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "wearable_restricted",
        "medical_restricted"
      ]
    },
    "security_zone": {
      "enum": [
        "public_marketing",
        "corporate_office",
        "product_device",
        "wearable_user",
        "medical_research",
        "management"
      ]
    }
  }
}

