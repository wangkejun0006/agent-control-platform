{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "ModelRoute 描述框架无关的模型传输、能力和治理边界；不包含真实 Endpoint 或 Credential。",
  "$id": "urn:company-ai-os:schema:model-route:0.1",
  "title": "Company AI OS ModelRoute",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "ModelRoute" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "version", "status", "evidence_status", "synthetic_only"],
      "properties": {
        "route_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
        "status": { "enum": ["draft", "evaluation", "approved", "suspended", "retired"] },
        "evidence_status": { "enum": ["synthetic", "architecture_reference", "verified_runtime"] },
        "synthetic_only": { "type": "boolean" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "endpoint_ref",
        "authentication",
        "model_refs",
        "capabilities",
        "data_policy",
        "request_limits",
        "fallback_route_refs",
        "budget_policy_ref",
        "audit_policy_ref"
      ],
      "properties": {
        "transport": {
          "enum": ["openai_chat_completions", "openai_responses", "anthropic_messages"]
        },
        "endpoint_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "credential_ref"],
          "properties": {
            "mode": { "enum": ["none", "api_key_ref", "oauth_ref", "workload_identity_ref"] },
            "credential_ref": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^(?:secretref|oauthref|wid)_[a-z0-9][a-z0-9_-]{2,79}$" }
              ]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
              "then": { "properties": { "credential_ref": { "type": "null" } } },
              "else": { "properties": { "credential_ref": { "type": "string" } } }
            }
          ]
        },
        "model_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["text", "tool_calling", "structured_output", "reasoning", "streaming", "vision"]
          }
        },
        "data_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_classifications",
            "training_use",
            "retention_policy_ref",
            "residency_policy_ref",
            "outbound_content_policy_ref"
          ],
          "properties": {
            "allowed_classifications": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/classification" }
            },
            "training_use": { "enum": ["forbidden", "contractually_allowed"] },
            "retention_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" },
            "residency_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" },
            "outbound_content_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" }
          }
        },
        "request_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_context_tokens", "timeout_seconds", "max_retries", "max_concurrency"],
          "properties": {
            "max_context_tokens": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "max_retries": { "type": "integer", "minimum": 0 },
            "max_concurrency": { "type": "integer", "minimum": 1 }
          }
        },
        "fallback_route_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
        },
        "budget_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" },
        "audit_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" }
      }
    }
  }
}

