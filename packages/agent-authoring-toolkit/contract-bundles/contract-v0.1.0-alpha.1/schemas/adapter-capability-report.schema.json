{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "AdapterCapabilityReport 固定某 Adapter/Runtime Revision 的可验证能力和限制；产品声明、静态映射与实测结果不得混为一谈。",
  "$id": "urn:company-ai-os:schema:adapter-capability-report:0.1",
  "title": "Company AI OS AdapterCapabilityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "AdapterCapabilityReport" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "version", "status", "evidence_status", "synthetic_only", "observed_at"],
      "properties": {
        "report_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
        "status": { "enum": ["draft", "verified", "superseded"] },
        "evidence_status": { "enum": ["synthetic", "architecture_reference", "verified_runtime"] },
        "synthetic_only": { "type": "boolean" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_adapter_ref", "runtime_revision_ref", "conformance_profile_ref", "capabilities", "unsupported_capabilities", "evidence_refs", "limitations"],
      "properties": {
        "runtime_adapter_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "runtime_revision_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "conformance_profile_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "support", "evidence_kind", "evidence_ref"],
            "properties": {
              "capability": { "enum": ["dispatch", "authentication", "idempotency", "cancel", "timeout", "checkpoint", "resume", "stream_events", "tool_interception", "result_reference", "audit_correlation", "sandbox_mapping"] },
              "support": { "enum": ["supported", "partial", "unsupported", "not_tested"] },
              "evidence_kind": { "enum": ["vendor_documentation", "static_mapping", "synthetic_test", "runtime_test"] },
              "evidence_ref": { "type": "string", "minLength": 3, "maxLength": 240 }
            }
          }
        },
        "unsupported_capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 240 } },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 240 } },
        "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 500 } }
      }
    }
  }
}

