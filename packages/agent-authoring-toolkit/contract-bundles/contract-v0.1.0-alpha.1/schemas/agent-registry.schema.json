{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Agent Registry 0.3 只保存治理状态和对 Definition/Binding 的精确引用，不复制 Prompt、Runtime 或授权内容。",
  "$id": "urn:company-ai-os:schema:agent-registry:0.3",
  "title": "Company AI OS Agent Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "AgentRegistryRecord" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "agent_id", "status", "evidence_status", "synthetic_only", "created_at", "updated_at"],
      "properties": {
        "record_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "agent_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "status": { "enum": ["draft", "evaluation", "active", "suspended", "retired"] },
        "evidence_status": { "enum": ["synthetic", "architecture_reference", "verified_runtime"] },
        "synthetic_only": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_ref",
        "binding_refs",
        "owner_role_ref",
        "hierarchy_node_ref",
        "approval_policy_refs",
        "audit_policy_ref",
        "retirement_policy_ref"
      ],
      "properties": {
        "definition_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
        "binding_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
        },
        "owner_role_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/role_ref" },
        "hierarchy_node_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/node_ref" },
        "approval_policy_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" }
        },
        "audit_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" },
        "retirement_policy_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" },
        "change_reason": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}

