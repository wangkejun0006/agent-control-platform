{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "AgentScaffoldRequest 是设计期生成输入，不是部署请求、有效授权或 Git 写入批准。",
  "$id": "urn:company-ai-os:schema:agent-scaffold-request:0.1",
  "title": "Company AI OS AgentScaffoldRequest Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "company-ai-os/v1alpha1" },
    "kind": { "const": "AgentScaffoldRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "version", "status", "evidence_status", "synthetic_only"],
      "properties": {
        "request_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
        "version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
        "status": { "enum": ["draft", "reviewed", "consumed", "superseded"] },
        "evidence_status": { "enum": ["synthetic", "architecture_reference"] },
        "synthetic_only": { "type": "boolean" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_source",
        "generation_scope",
        "target",
        "business_requirements",
        "environment",
        "requested_outputs",
        "generation_policy",
        "acceptance"
      ],
      "properties": {
        "contract_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_id",
            "contract_api_version",
            "contract_version",
            "git_commit",
            "manifest_digest",
            "schema_locks"
          ],
          "properties": {
            "release_id": {
              "type": "string",
              "pattern": "^contract-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
            },
            "contract_api_version": { "const": "company-ai-os/v1alpha1" },
            "contract_version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
            "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "manifest_digest": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/digest" },
            "schema_locks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["schema_id", "digest"],
                "properties": {
                  "schema_id": { "type": "string", "pattern": "^urn:company-ai-os:schema:[a-z0-9-]+:[0-9.]+$" },
                  "digest": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/digest" }
                }
              }
            }
          }
        },
        "generation_scope": { "enum": ["system_overlay", "agent_release"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization_ref",
            "department_ref",
            "system_ref",
            "agent_target",
            "target_repository_ref"
          ],
          "properties": {
            "organization_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
            "department_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
            "system_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
            "agent_target": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["agent_id", "operation", "requested_version", "baseline_definition_ref"],
                  "properties": {
                    "agent_id": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/id" },
                    "operation": { "enum": ["create", "revise"] },
                    "requested_version": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/semantic_version" },
                    "baseline_definition_ref": {
                      "oneOf": [
                        { "type": "null" },
                        { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "operation": { "const": "create" } }, "required": ["operation"] },
                      "then": { "properties": { "baseline_definition_ref": { "type": "null" } } },
                      "else": { "properties": { "baseline_definition_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" } } }
                    }
                  ]
                }
              ]
            },
            "target_repository_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" }
          }
        },
        "business_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "allowed_outcomes",
            "prohibited_outcomes",
            "owner_role_refs",
            "human_checkpoints",
            "data_classifications",
            "domain_policy_refs",
            "max_autonomy",
            "model_usage",
            "model_selection_status",
            "runtime_candidate_families"
          ],
          "properties": {
            "purpose": { "type": "string", "minLength": 10, "maxLength": 1000 },
            "allowed_outcomes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3, "maxLength": 240 }
            },
            "prohibited_outcomes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3, "maxLength": 240 }
            },
            "owner_role_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/role_ref" }
            },
            "human_checkpoints": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3, "maxLength": 200 }
            },
            "data_classifications": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/classification" }
            },
            "domain_policy_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/policy_ref" }
            },
            "max_autonomy": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/autonomy" },
            "model_usage": { "enum": ["forbidden", "optional", "required", "mixed"] },
            "model_selection_status": { "enum": ["pending", "selected", "not_required"] },
            "runtime_candidate_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment_ref", "execution_location", "isolation", "network", "data_mode"],
          "properties": {
            "environment_ref": { "$ref": "urn:company-ai-os:schema:agent-common:0.1#/$defs/versioned_ref" },
            "execution_location": { "enum": ["local_workstation", "adapted_server", "managed_service"] },
            "isolation": { "enum": ["process", "container", "virtual_machine"] },
            "network": { "enum": ["deny", "allowlisted"] },
            "data_mode": { "enum": ["public_or_synthetic_only", "domain_governed"] }
          }
        },
        "requested_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture_view",
              "contract_lock",
              "domain_invariants",
              "agent_definition",
              "agent_binding",
              "agent_capability_profile",
              "agent_registry_record",
              "runtime_selection_assessment",
              "runtime_realization",
              "agent_release_manifest",
              "negative_cases",
              "validation_configuration",
              "decision_record"
            ]
          }
        },
        "generation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "write_mode",
            "existing_file_policy",
            "git_mutation",
            "external_side_effects",
            "runtime_execution",
            "effective_grant_generation",
            "secret_material",
            "human_review_required"
          ],
          "properties": {
            "write_mode": { "enum": ["plan_only", "staging_only"] },
            "existing_file_policy": { "enum": ["fail_on_conflict", "patch_in_staging"] },
            "git_mutation": { "const": "forbidden" },
            "external_side_effects": { "const": "forbidden" },
            "runtime_execution": { "const": "forbidden" },
            "effective_grant_generation": { "const": "forbidden" },
            "secret_material": { "const": "forbidden" },
            "human_review_required": { "const": true }
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_checks", "negative_scenarios"],
          "properties": {
            "required_checks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "schema_strict",
                  "yaml_safe_parse",
                  "reference_hashes",
                  "permission_subsets",
                  "domain_negative_cases",
                  "internal_links",
                  "sensitive_content",
                  "diff_review"
                ]
              }
            },
            "negative_scenarios": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3, "maxLength": 240 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "generation_scope": { "const": "system_overlay" } }, "required": ["generation_scope"] },
          "then": {
            "properties": {
              "target": { "type": "object", "properties": { "agent_target": { "type": "null" } } },
              "requested_outputs": {
                "type": "array",
                "allOf": [
                  { "contains": { "const": "contract_lock" }, "minContains": 1 },
                  { "contains": { "const": "domain_invariants" }, "minContains": 1 },
                  { "contains": { "const": "agent_definition" }, "minContains": 1 },
                  { "contains": { "const": "agent_binding" }, "minContains": 1 },
                  { "contains": { "const": "negative_cases" }, "minContains": 1 }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "target": { "type": "object", "properties": { "agent_target": { "type": "object" } } },
              "requested_outputs": {
                "type": "array",
                "allOf": [
                  { "contains": { "const": "agent_definition" }, "minContains": 1 },
                  { "contains": { "const": "agent_binding" }, "minContains": 1 },
                  { "contains": { "const": "agent_capability_profile" }, "minContains": 1 },
                  { "contains": { "const": "agent_registry_record" }, "minContains": 1 },
                  { "contains": { "const": "agent_release_manifest" }, "minContains": 1 },
                  { "contains": { "const": "negative_cases" }, "minContains": 1 }
                ]
              }
            }
          }
        }
      ]
    }
  }
}

